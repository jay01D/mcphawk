{
  "name": "mcptrace",
  "version": "0.0.1",
  "description": "Transparent stdio proxy for MCP servers. Live timeline, SQLite log, replay. Zero config.",
  "type": "module",
  "license": "MIT",
  "author": "Jay Doshi",
  "main": "./dist/cli.js",
  "bin": {
    "mcptrace": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src test",
    "format": "biome format --write src test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "observability",
    "debugger",
    "proxy",
    "json-rpc"
  ],
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
